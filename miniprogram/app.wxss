/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 主题色 */
.primary-color {
  color: #ff6b35;
}

.primary-bg {
  background-color: #ff6b35;
}

/* 通用按钮 */
.btn-primary {
  background-color: #ff6b35;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-disabled {
  background-color: #cccccc;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
}

/* 卡片容器 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* flex 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
