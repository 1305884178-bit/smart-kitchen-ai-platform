/* pages/my-orders/index.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.order-card {
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.order-no {
  font-size: 26rpx;
  color: #666;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.status-0 { background: #e3f2fd; color: #1976d2; }
.status-1 { background: #e8f5e9; color: #388e3c; }
.status-2 { background: #fff3e0; color: #e65100; }
.status-3 { background: #fce4ec; color: #c62828; }

.order-info {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.order-amount {
  color: #ff6b35;
  font-weight: 500;
}

.order-dishes {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.order-time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

.loading-tip, .no-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 28rpx;
}
