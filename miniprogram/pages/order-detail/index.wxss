/* pages/order-detail/index.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
}

.order-no {
  font-size: 28rpx;
  color: #666;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-0 { background: #e3f2fd; color: #1976d2; }
.status-10 { background: #e8f5e9; color: #388e3c; }
.status-20 { background: #fff3e0; color: #e65100; }
.status-90 { background: #fce4ec; color: #c62828; }

.order-info {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.order-info text {
  display: block;
}

.remark-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
  background: #fafafa;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}

.pay-countdown {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #e6432d;
  background: #fef0ef;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.item-price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 500;
  margin-left: 20rpx;
  white-space: nowrap;
}

.added-tag {
  font-size: 20rpx;
  color: #ff6b35;
  background: #fff3e0;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

.off-shelf-tag {
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 8rpx;
}

.action-section {
  padding: 24rpx;
}

.action-btn {
  width: 100%;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.action-btn::after {
  border: none;
}

.action-PAY {
  background: #ff6b35;
  color: #fff;
}

.action-ADD_DISH {
  background: #e3f2fd;
  color: #1976d2;
}

.action-REVIEW {
  background: #e8f5e9;
  color: #388e3c;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

.loading-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
