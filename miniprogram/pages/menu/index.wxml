<!--pages/menu/index.wxml-->
<view class="page-container">
  <!-- 分类Tab -->
  <scroll-view class="category-tabs" scroll-x>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="tab-item {{activeCategoryId === item.id ? 'tab-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 菜品列表 -->
  <scroll-view class="dish-list" scroll-y>
    <view class="dish-card" wx:for="{{dishes}}" wx:key="id" data-dish-id="{{item.id}}" bindtap="onDishTap">
      <image class="dish-img" src="{{item.image || '/images/default-dish.png'}}" mode="aspectFill" />
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-meta">
          <text class="dish-price">¥{{item.price}}</text>
          <text class="dish-stock {{item.dailyStock <= 0 ? 'out-of-stock' : ''}}">
            {{item.dailyStock > 0 ? '有货' : '售罄'}}
          </text>
        </view>
      </view>
      <view
        class="add-btn {{item.dailyStock <= 0 ? 'btn-disabled' : ''}}"
        data-dish="{{item}}"
        catchtap="onAddToCart"
      >+</view>
    </view>

    <view wx:if="{{dishes.length === 0}}" class="empty-tip">暂无菜品</view>
  </scroll-view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar safe-bottom">
    <view class="cart-icon-wrap" bindtap="onGoToOrder">
      <text class="cart-icon">🛒</text>
      <text wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</text>
    </view>
    <view class="cart-total">¥{{cartTotal}}</view>
    <view class="cart-go-btn {{cartCount > 0 ? '' : 'btn-disabled'}}" bindtap="onGoToOrder">
      去下单
    </view>
  </view>
</view>
