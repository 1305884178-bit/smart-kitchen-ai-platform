<!--pages/menu/index.wxml-->
<view class="page-container">
  <!-- 分类Tab -->
  <scroll-view class="category-tabs" scroll-x>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="tab-item {{activeCategoryId === item.id ? 'tab-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 菜品列表 -->
  <scroll-view class="dish-list" scroll-y>
    <view class="dish-card" wx:for="{{dishes}}" wx:key="id" data-dish-id="{{item.id}}" bindtap="onDishTap">
      <image class="dish-img" src="{{item.displayImage}}" mode="aspectFill" data-dish-id="{{item.id}}" binderror="onDishImageError" />
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-meta">
          <text class="dish-price">¥{{item.price}}</text>
          <text class="dish-stock {{item.dailyStock <= 0 ? 'out-of-stock' : ''}}">
            {{item.dailyStock > 0 ? '有货' : '售罄'}}
          </text>
        </view>
      </view>
      <view
        wx:if="{{item.dailyStock > 0}}"
        class="add-btn"
        data-dish="{{item}}"
        catchtap="onAddToCart"
      >+</view>
    </view>

    <view wx:if="{{dishes.length === 0}}" class="empty-tip">暂无菜品</view>
  </scroll-view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar safe-bottom">
    <view class="cart-icon-wrap" bindtap="onGoToOrder">
      <text class="cart-icon">🛒</text>
      <text wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</text>
    </view>
    <view class="cart-info">
      <view wx:if="{{addingDish && addToSeatNumber}}" class="cart-seat-label">座位：{{addToSeatNumber}}</view>
      <view class="cart-total">¥{{cartTotal}}</view>
    </view>
    <view class="cart-go-btn {{cartCount > 0 ? '' : 'btn-disabled'}}" bindtap="onGoToOrderDirect">
      {{addingDish ? '确认加菜' : '去下单'}}
    </view>
  </view>

  <!-- 购物车弹窗 -->
  <view wx:if="{{showCartPopup}}" class="cart-popup-mask" bindtap="onCloseCartPopup"></view>
  <view wx:if="{{showCartPopup}}" class="cart-popup {{showCartPopup ? 'cart-popup-show' : ''}}">
    <view class="cart-popup-header">
      <text class="cart-popup-title">购物车</text>
      <text class="cart-popup-close" bindtap="onCloseCartPopup">✕</text>
    </view>

    <scroll-view class="cart-popup-body" scroll-y>
      <view class="cart-popup-item" wx:for="{{cartItems}}" wx:key="dishId">
        <image class="cart-item-img" src="{{item.displayImage}}" mode="aspectFill" data-dish-id="{{item.dishId}}" binderror="onCartImageError" />
        <view class="cart-item-info">
          <text class="cart-item-name">{{item.dishName}}</text>
          <text class="cart-item-price">
            <text wx:if="{{!item.active}}" class="off-shelf-tag">已下架</text>
            {{item.active ? '¥' + item.price : ''}}
          </text>
        </view>
        <view class="cart-item-ctrl">
          <view class="ctrl-btn" data-dish-id="{{item.dishId}}" catchtap="onCartDecrease">-</view>
          <text class="ctrl-num">{{item.quantity}}</text>
          <view class="ctrl-btn" data-dish-id="{{item.dishId}}" catchtap="onCartIncrease">+</view>
        </view>
      </view>
      <view wx:if="{{cartItems.length === 0}}" class="empty-tip">购物车空空如也~</view>
    </scroll-view>

    <view class="cart-popup-footer safe-bottom">
      <view wx:if="{{addingDish && addToSeatNumber}}" class="cart-seat-info">座位：{{addToSeatNumber}}（不可更改）</view>
      <view class="cart-popup-total">合计：<text class="total-amount">¥{{cartTotal}}</text></view>
      <view class="cart-popup-submit {{cartCount > 0 ? '' : 'btn-disabled'}}" bindtap="onCartGoToOrder">{{addingDish ? '确认加菜' : '去下单'}}</view>
    </view>
  </view>
</view>
