/* pages/menu/index.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.category-tabs {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  background: #fff;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}

.tab-active {
  background: #ff6b35;
  color: #fff;
}

.dish-list {
  flex: 1;
  padding-bottom: 120rpx;
}

.dish-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.dish-meta {
  display: flex;
  align-items: center;
}

.dish-price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

.dish-stock {
  font-size: 24rpx;
  color: #52c41a;
  margin-left: 16rpx;
}

.out-of-stock {
  color: #ccc;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  font-size: 36rpx;
  flex-shrink: 0;
}

.add-btn:active {
  opacity: 0.8;
}

/* 购物车栏 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.cart-icon-wrap {
  position: relative;
  margin-right: 20rpx;
}

.cart-icon {
  font-size: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  padding: 0 6rpx;
}

.cart-total {
  flex: 1;
  font-size: 34rpx;
  font-weight: bold;
  color: #ff6b35;
}

.cart-go-btn {
  padding: 16rpx 40rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}
