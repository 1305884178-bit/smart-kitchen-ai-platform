/* pages/menu/index.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.category-tabs {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  background: #fff;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}

.tab-active {
  background: #ff6b35;
  color: #fff;
}

.dish-list {
  flex: 1;
  padding-bottom: 120rpx;
}

.dish-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.dish-meta {
  display: flex;
  align-items: center;
}

.dish-price {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}

.dish-stock {
  font-size: 24rpx;
  color: #52c41a;
  margin-left: 16rpx;
}

.out-of-stock {
  color: #ccc;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  font-size: 36rpx;
  flex-shrink: 0;
}

.add-btn:active {
  opacity: 0.8;
}

/* 购物车栏 */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.cart-icon-wrap {
  position: relative;
  margin-right: 20rpx;
}

.cart-icon {
  font-size: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  padding: 0 6rpx;
}

.cart-total {
  flex: 1;
  font-size: 34rpx;
  font-weight: bold;
  color: #ff6b35;
}

.cart-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cart-seat-label {
  font-size: 24rpx;
  color: #1976d2;
  line-height: 1.4;
}

.cart-go-btn {
  padding: 16rpx 40rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* 购物车弹窗 */
.cart-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.cart-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-sizing: border-box;
  overflow: hidden;
}

.cart-popup-show {
  transform: translateY(0);
}

.cart-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.cart-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.cart-popup-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.cart-popup-body {
  flex: 1;
  max-height: 50vh;
  padding: 0;
  box-sizing: border-box;
}

.cart-popup-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}

.cart-item-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.cart-item-info {
  flex: 1;
  margin-left: 12rpx;
  overflow: hidden;
  min-width: 0;
}

.cart-item-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-item-price {
  font-size: 26rpx;
  color: #ff6b35;
  font-weight: 500;
}

.off-shelf-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.cart-item-ctrl {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ctrl-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 500;
  background: #f5f5f5;
  color: #333;
}

.ctrl-btn:active {
  background: #e0e0e0;
}

.ctrl-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin: 0 4rpx;
}

.cart-popup-footer {
  display: flex;
  flex-direction: column;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cart-popup-footer .cart-popup-total {
  width: 100%;
}

.cart-popup-footer .cart-popup-submit {
  width: 100%;
  text-align: center;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.cart-seat-info {
  font-size: 26rpx;
  color: #1976d2;
  background: #e3f2fd;
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.cart-popup-total {
  font-size: 30rpx;
  color: #333;
}

.total-amount {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff6b35;
}

.cart-popup-submit {
  padding: 16rpx 48rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}
