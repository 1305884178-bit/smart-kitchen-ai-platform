/* pages/dish-detail/index.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.detail-img {
  width: 100%;
  height: 480rpx;
  background: #f0f0f0;
}

.detail-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.detail-price {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.detail-stock {
  font-size: 26rpx;
  color: #52c41a;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.ingredients-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.add-cart-btn {
  width: 100%;
  background: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
}

.add-cart-btn::after {
  border: none;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
