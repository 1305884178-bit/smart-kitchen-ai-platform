<!--pages/dish-detail/index.wxml-->
<view class="page-container">
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <block wx:elif="{{dish}}">
    <!-- 菜品大图 -->
    <image class="detail-img" src="{{dish.displayImage}}" mode="aspectFill" binderror="onDishImageError" />

    <view class="card">
      <view class="detail-name">{{dish.name}}</view>
      <view class="detail-price">¥{{dish.price}}</view>
      <view class="detail-stock {{dish.dailyStock <= 0 ? 'out-of-stock' : ''}}">
        {{dish.dailyStock > 0 ? '库存: ' + dish.dailyStock + '份' : '已售罄'}}
      </view>
    </view>

    <!-- 配料/过敏原信息 -->
    <view class="card">
      <view class="section-title">配料与过敏原</view>
      <view class="ingredients-text">{{dish.ingredients || '暂无配料信息'}}</view>
    </view>
  </block>

  <view wx:else class="empty-tip">菜品不存在</view>

  <!-- 底部加入购物车按钮 -->
  <view wx:if="{{dish}}" class="bottom-bar safe-bottom">
    <button
      class="add-cart-btn {{dish.dailyStock <= 0 ? 'btn-disabled' : ''}}"
      bindtap="onAddToCart"
      disabled="{{dish.dailyStock <= 0}}"
    >加入购物车</button>
  </view>
</view>
