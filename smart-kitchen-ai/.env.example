# ============ MySQL ============
# 注意：生产环境 DB_USER 应为 Python 侧专用的只读账号（仅需 SELECT），
# 授权语句由 DBA 在数据库侧执行，不要写进代码或提交真实账号
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PWD=
DB_NAME=smart_kitchen
# Python 侧连接池上限（保持个位数，避免与 Java Hikari 最大 20 抢死 MySQL）
DB_POOL_SIZE=5

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PWD=
REDIS_DB=0

# ============ Milvus Lite ============
# 本地库文件路径（评测脚本 eval/run_eval.py 会用独立临时库覆盖，勿指向生产库）
MILVUS_DB_PATH=data/milvus.db

# ============ LLM（DeepSeek 兼容接口）============
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ============ Embedding（百炼兼容接口，1024 维）============
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ============ 语义缓存 ============
# 命中阈值（余弦相似度），与 RAG 阈值相互独立，禁止共用
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_COLLECTION=ai_chat_semantic_cache
SEMANTIC_CACHE_TTL_DAYS=7
# kb_version 指纹在 Redis 的兜底缓存秒数
KB_VERSION_CACHE_TTL=60

# ============ RAG 知识库 ============
# 检索相似度阈值（COSINE distance 下限）。调参依据见 config.py 注释；
# 修改后用 eval/run_eval.py 复测，建议区间 0.55~0.70
RAG_SCORE_THRESHOLD=0.55
# Dense 与 BM25 独立粗召回数量、RRF 融合候选数。知识库较小时 BM25 每次按同一状态过滤读取，
# 不维护第二份易失效的本地索引。
RAG_DENSE_RECALL_LIMIT=12
RAG_BM25_RECALL_LIMIT=12
RAG_FUSION_CANDIDATE_LIMIT=10
RAG_RRF_K=60
# 可选云端 Reranker：接口需接受 {model, query, documents, top_n}，返回 results 中的 index / relevance_score。
# 默认不启用；开关、URL、Key 任一缺失时，自动返回 RRF 融合结果，不会请求外部网络。
RERANKER_ENABLED=false
RERANKER_API_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT_SECONDS=5
# 归档文档向量保留天数（每日 03:30 定时清理；active 文档不受此任务影响）
KB_ARCHIVED_RETENTION_DAYS=7

# ============ 多轮对话 ============
# 送入 ReAct Agent 的最近消息数（含当前条），全量历史禁止
CHAT_HISTORY_MAX_MESSAGES=8

# ============ 安全 ============
# /ai/chat 校验 C 端 JWT 的 HMAC 密钥；必须与 Java smart-kitchen.jwt.secret 一致，且至少 32 字节
JWT_SECRET=
# 服务间接口（/ai/knowledge/*、/ai/predict/*）Bearer token；
# 配置后强制校验，Java 侧对应 smart-kitchen.python-service.internal-token；留空不校验便于本地联调
AI_INTERNAL_TOKEN=
# /ai/chat 限流（按用户/IP 滑动窗口，次/分钟，0 关闭）
CHAT_RATE_LIMIT_PER_MINUTE=30

# ============ 其他 ============
WEATHER_API_KEY=
WEATHER_CITY=Shenzhen
JAVA_API_URL=http://localhost:8080
APP_PORT=8000
